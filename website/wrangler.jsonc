// Generated by scripts/sync-config.mjs from site.config.json. Do not edit by hand.
// Deploy: npm run deploy  (build + wrangler deploy)
{
  "name": "elsewhere-site",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/download",
      "/download/"
    ]
  },
  "vars": {
    "GITHUB_REPO": "Sriharan-S/elsewhere",
    "USER_AGENT": "elsewhere-site"
  },
  "routes": [
    {
      "pattern": "elsewhere.sriharan.me",
      "custom_domain": true
    }
  ]
}
